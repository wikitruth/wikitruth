{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./server/src",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "allowJs": false,
    "checkJs": false,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": "."
  },
  "include": ["server/src/**/*.ts", "server/src/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "public/dist",
    "public/components",
    "client",
    "tests",
    "react-tutorial"
  ]
}
