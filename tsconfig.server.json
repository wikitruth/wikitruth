{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": false,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "*": [
        "node_modules/*"
      ]
    }
  },
  "include": [
    "app.js",
    "server.js",
    "config/**/*.js",
    "controllers/**/*.js",
    "controllers/**/*.ts",
    "middlewares/**/*.js",
    "middlewares/**/*.ts",
    "models/**/*.js",
    "models/**/*.ts",
    "services/**/*.js",
    "services/**/*.ts",
    "utils/**/*.js",
    "utils/**/*.ts",
    "types/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "public/dist",
    "public/components",
    "client",
    "tests",
    "react-tutorial"
  ]
}
