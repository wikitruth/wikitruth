{
    "express": {
        "view cache": false,
        "view engine": "dust",
        "views": "path:./legacy/templates"
    },

    "view engines": {
        "dust": {
            "module": "engine-munger",
            "renderer": {
                "method": "dust",
                "arguments": [
                    { "cache": false },
                    {
                        "views": "config:express.views",
                        "view engine": "config:express.view engine",
                        "specialization": "config:specialization",
                        "i18n": "config:i18n"
                    }
                ]
            }
        }
    },

    "middleware": {

        "fileNotFound": {
            "enabled": false,
            "priority": 130,
            "module": {
                "name": "kraken-js/middleware/404",
                "arguments": [ "dust/errors/404" ]
            }
        },
        "serverError": {
            "enabled": false,
            "priority": 140,
            "module": {
                "name": "kraken-js/middleware/500",
                "arguments": [ "dust/errors/500" ]
            }
        }
    }
}
