# Backend runtime
PORT=8000
HTTPS_ENABLED=false
HTTPS_PORT=8443
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=
HTTP_TO_HTTPS_REDIRECT=false
LEGACY_COMPATIBILITY_ENABLED=true
# Optional overrides (relative to project root unless absolute path):
# LEGACY_COMPATIBILITY_STATIC_ROOT=legacy/compatibility/static
# LEGACY_COMPATIBILITY_TEMPLATES_ROOT=legacy/compatibility/templates/jade
MONGODB_URI=mongodb://127.0.0.1:27017/wikitruth
MONGODB_DBNAME=wikitruth
SYSTEM_EMAIL=dev@example.com
WIKITRUTH_CRYPTO_KEY=replace-with-strong-key
WIKITRUTH_JWT_SECRET=replace-with-strong-secret
TRUST_PROXY=false
SESSION_COOKIE_SECURE=false
MOBILE_ACCESS_TOKEN_TTL_SECONDS=900
MOBILE_REFRESH_TOKEN_TTL_SECONDS=2592000
MOBILE_MAX_REFRESH_SESSIONS=10
MOBILE_API_RATE_LIMIT_PER_MINUTE=240
MOBILE_API_RATE_LIMIT_WINDOW_MS=60000
API_DEPRECATION_SUNSET=2028-12-31T23:59:59.000Z
API_DEPRECATION_POLICY_URL=https://wikitruth.net/docs/deprecations

# React client build-time
REACT_APP_API_BASE_URL=/api
REACT_APP_ERROR_REPORT_ENDPOINT=
REACT_APP_ENVIRONMENT=development
CDN_ASSET_PREFIX=/dist/
ANALYZE_BUNDLE=false
