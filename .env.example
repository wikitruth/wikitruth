# Backend runtime
NODE_ENV=development
PORT=8000
HTTPS_ENABLED=false
HTTPS_PORT=8443
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=
HTTP_TO_HTTPS_REDIRECT=false

# Legacy compatibility bridge
LEGACY_COMPATIBILITY_ENABLED=true
LEGACY_COMPATIBILITY_MOUNT_PATH=/legacy
LEGACY_COMPATIBILITY_STATIC_ROOT=legacy/static
LEGACY_COMPATIBILITY_TEMPLATES_ROOT=legacy/templates

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/wikitruth
MONGODB_DBNAME=wikitruth
MONGODB_BACKUP_ROOT=~/config/mongodb
# Set only for one-time empty-database recovery; use at least 16 random characters.
WIKITRUTH_INSTALL_TOKEN=
MONGODB_PRIVATE_BACKUP_ROOT=~/config/mongodb

# Project identity
COMPANY_NAME=Wikitruth Foundation
PROJECT_NAME=Wikitruth
TITLE_SLOGAN=Wikitruth, the truth in totality of human knowledge
HOME_URL=https://wikitruth.net
SYSTEM_EMAIL=dev@example.com

# Security secrets
WIKITRUTH_CRYPTO_KEY=replace-with-strong-key
WIKITRUTH_JWT_SECRET=replace-with-strong-secret
CACHE_BREAKER=
TRUST_PROXY=false

# Session
SESSION_COOKIE_NAME=sid
SESSION_RESAVE=false
SESSION_SAVE_UNINITIALIZED=false
SESSION_ROLLING=false
SESSION_PROXY=false
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_MAX_AGE_MS=1209600000

# CSRF
CSRF_IGNORE_METHODS=GET,HEAD,OPTIONS
CSRF_COOKIE_SIGNED=true
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_SAMESITE=lax

# Security headers (Helmet)
SECURITY_HELMET_ENABLED=true
SECURITY_HELMET_CONTENT_SECURITY_POLICY=false
SECURITY_HELMET_COEP=false
SECURITY_HELMET_CORP=cross-origin
SECURITY_HELMET_REFERRER_POLICY=no-referrer
SECURITY_HELMET_HSTS_ENABLED=false
SECURITY_HELMET_HSTS_MAX_AGE=15552000
SECURITY_HELMET_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HELMET_HSTS_PRELOAD=false

# Login and verification controls
LOGIN_ATTEMPTS_FOR_IP=50
LOGIN_ATTEMPTS_FOR_IP_AND_USER=7
LOGIN_ATTEMPTS_LOG_EXPIRATION=20m
REQUIRE_ACCOUNT_VERIFICATION=false

# Mobile API
MOBILE_ACCESS_TOKEN_TTL_SECONDS=900
MOBILE_REFRESH_TOKEN_TTL_SECONDS=2592000
MOBILE_MAX_REFRESH_SESSIONS=10
MOBILE_API_RATE_LIMIT_PER_MINUTE=240
MOBILE_API_RATE_LIMIT_WINDOW_MS=60000
API_DEPRECATION_SUNSET=2028-12-31T23:59:59.000Z
API_DEPRECATION_POLICY_URL=https://wikitruth.net/docs/deprecations

# SMTP / email delivery
SMTP_FROM_NAME=Wikitruth
SMTP_FROM_ADDRESS=dev@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_SSL=true

# Anti-bot and analytics
GRECAPTCHA_SITEKEY=
GRECAPTCHA_SECRET=
GOOGLE_ANALYTICS_TRACKING_ID=

# OAuth providers (optional)
TWITTER_OAUTH_KEY=
TWITTER_OAUTH_SECRET=
FACEBOOK_OAUTH_KEY=
FACEBOOK_OAUTH_SECRET=
GITHUB_OAUTH_KEY=
GITHUB_OAUTH_SECRET=
GOOGLE_OAUTH_KEY=
GOOGLE_OAUTH_SECRET=
APPLE_OAUTH_KEY=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY_LOCATION=
MICROSOFT_OAUTH_KEY=
MICROSOFT_OAUTH_SECRET=
MICROSOFT_OAUTH_TENANT=common
TUMBLR_OAUTH_KEY=
TUMBLR_OAUTH_SECRET=

# Compatibility aliases (optional; use primary names above by default)
# HTTPS_REDIRECT_HTTP=false
# MONGOLAB_URI=
# MONGOHQ_URL=
# WIKITRUTH_SYSTEM_EMAIL=
# CRYPTO_KEY=
# JWT_SECRET=

# React client build-time
REACT_APP_API_BASE_URL=/api
REACT_APP_ERROR_REPORT_ENDPOINT=
REACT_APP_ENVIRONMENT=development
REACT_APP_RECAPTCHA_SITE_KEY=
REACT_APP_ANALYTICS_ID=
CDN_ASSET_PREFIX=/dist/
ANALYZE_BUNDLE=false
