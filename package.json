    "husky": "8.0.3",
    "jest": "30.4.2",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^15.5.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.5",
    "storybook": "10.5.0",
    "style-loader": "4.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "webpack": "^5.108.4",
    "webpack-bundle-analyzer": "^5.3.0",
    "webpack-cli": "7.2.1",
    "webpack-dev-server": "6.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "graceful-fs": "^4.2.11"
  },
  "engines": {
    "node": ">=22.15.0 <25",
    "npm": ">=10.8.1 <12"
  }
}
