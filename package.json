{
  "name": "wikitruth",
  "version": "0.5.2",
  "description": "Wikipedia and Quora-like system with a vetting mechanism to classify facts from opinions",
  "author": "Wikitruth Foundation",
  "main": "app.js",
  "scripts": {
    "test": "npm-run-all test:server test:client",
    "start": "node server.js",
    "update": "npm outdated",
    "all": "npm run build && npm run test",
    "start:dist": "tsc -p tsconfig.server.json && node dist/server.js",
    "dev": "npm run dev:server",
    "dev:server": "nodemon --exec ts-node app",
    "dev:client": "webpack serve --mode development --hot",
    "dev:all": "npm-run-all --parallel dev:server dev:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "webpack --config webpack.config.prod.js --mode production",
    "build:client:stats": "ANALYZE_BUNDLE=true webpack --config webpack.config.prod.js --mode production",
    "build:client:dev": "webpack --mode development",
    "build": "npm run build:server && npm run build:client",
    "build:dev": "npm run build:server && npm run build:client:dev",
    "test:jest": "jest",
    "test:client": "jest --config jest.config.client.js",
    "test:client:watch": "jest --config jest.config.client.js --watch",
    "test:coverage": "jest --config jest.config.client.js --coverage",
    "test:e2e": "playwright test",
    "test:ci": "npm-run-all lint type:guardrails test:server test:coverage build:client build:server",
    "storybook": "storybook dev -p 6006 -c .storybook",
    "storybook:build": "storybook build -c .storybook",
    "lint": "eslint client tests/server --ext .ts,.tsx,.js",
    "lint:fix": "eslint client tests/server --ext .ts,.tsx,.js --fix",
    "format": "prettier --write .",
    "prepare": "husky install",
    "tsc": "tsc -p tsconfig.server.json",
    "tsc:watch": "tsc -p tsconfig.server.json --watch",
    "type:check": "tsc -p tsconfig.server.json --noEmit",
    "type:metrics": "bash scripts/type-metrics.sh",
    "type:guardrails": "bash scripts/check-no-new-ts-nocheck.sh",
    "docs:drift": "bash scripts/migration-doc-drift-check.sh",
    "analyze:bundle": "npm run build:client:stats",
    "test:server": "jest --config jest.config.server.js",
    "start:legacy-grunt": "grunt"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wikitruth/wikitruth.git"
  },
  "dependencies": {
    "adaro": "^0.1.10",
    "async": "^3.2.6",
    "backbone": "^1.6.0",
    "bcrypt": "5.1.1",
    "bluebird": "^3.7.2",
    "body-parser": "^2.2.0",
    "compression": "^1.8.1",
    "connect-mongo": "5.1.0",
    "consolidate": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "csurf": "^1.10.0",
    "dust-makara-helpers": "^4.2.0",
    "dustjs-helpers": "~1.3.0",
    "emailjs": "^4.0.3",
    "engine-munger": "^0.2.9",
    "express": "^4.21.2",
    "express-session": "^1.18.2",
    "handlebars": "^4.7.8",
    "helmet": "7.1.0",
    "html-to-text": "^9.0.5",
    "imagemagick": "^0.1.3",
    "jade": "^1.11.0",
    "jsonwebtoken": "9.0.2",
    "kraken-devtools": "^1.4.0",
    "kraken-js": "^2.5.0",
    "less": "^3.13.1",
    "less-plugin-clean-css": "^1.6.0",
    "localizr": "^1.1.0",
    "makara": "^2.1.0",
    "method-override": "^3.0.0",
    "moment": "^2.30.1",
    "mongodb-backup-fixed": "^1.7.2",
    "mongoose": "^8.13.2",
    "morgan": "^1.10.1",
    "mv": "^2.1.1",
    "npm-run-all": "^4.1.5",
    "passport": "^0.4.1",
    "passport-apple": "^2.0.2",
    "passport-facebook": "^3.0.0",
    "passport-github": "^1.1.0",
    "passport-google": "^0.3.0",
    "passport-google-oauth": "1.0.0",
    "passport-local": "^1.0.0",
    "passport-microsoft": "^2.1.0",
    "passport-oauth": "^1.0.0",
    "passport-twitter": "^1.0.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "^6.20.1",
    "rimraf": "^6.0.1",
    "serve-static": "2.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "7.23.3",
    "@babel/preset-env": "7.23.3",
    "@babel/preset-react": "7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@playwright/test": "^1.58.2",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/react-webpack5": "8.6.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/async": "^3.2.24",
    "@types/bcrypt": "^5.0.2",
    "@types/bluebird": "^3.5.42",
    "@types/body-parser": "^1.19.5",
    "@types/compression": "^1.7.5",
    "@types/consolidate": "^0.14.4",
    "@types/cookie-parser": "^1.4.8",
    "@types/csurf": "^1.11.5",
    "@types/express": "^5.0.1",
    "@types/express-session": "^1.18.1",
    "@types/jest": "29.5.11",
    "@types/jest-axe": "^3.5.9",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/kraken-js": "^2.2.8",
    "@types/method-override": "^0.0.35",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.14.1",
    "@types/passport": "^1.0.17",
    "@types/passport-facebook": "^3.0.3",
    "@types/passport-github": "^1.1.12",
    "@types/passport-google-oauth": "^1.0.45",
    "@types/passport-local": "^1.0.38",
    "@types/passport-twitter": "^1.0.40",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "autocannon": "^8.0.0",
    "babel-loader": "9.1.3",
    "css-loader": "^6.8.1",
    "eslint": "8.55.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react": "7.33.2",
    "husky": "8.0.3",
    "jest": "29.7.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^15.5.1",
    "nodemon": "3.0.2",
    "prettier": "3.1.1",
    "storybook": "8.6.14",
    "style-loader": "^3.3.3",
    "supertest": "^3.4.2",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "webpack": "^5.99.5",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "^5.2.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "graceful-fs": "^4.2.11"
  },
  "engines": {
    "node": ">=22.4.1 <23",
    "npm": ">=10.8.1 <11"
  }
}
