{
  "name": "wikitruth",
  "version": "0.5.2",
  "description": "Wikipedia and Quora-like system with a vetting mechanism to classify facts from opinions",
  "author": "Wikitruth Foundation",
  "main": "app.js",
  "scripts": {
    "test": "npm-run-all test:server test:client",
    "start": "node --env-file-if-exists=.env server.js",
    "update": "npm outdated",
    "all": "npm run build && npm run test",
    "start:dist": "node --env-file-if-exists=.env ./node_modules/typescript/bin/tsc -p tsconfig.server.json && node --env-file-if-exists=.env server.js",
    "dev": "npm run dev:server",
    "dev:server": "node --env-file-if-exists=.env ./node_modules/nodemon/bin/nodemon.js --exec \"node --env-file-if-exists=.env ./node_modules/ts-node/dist/bin.js --files --project tsconfig.server.json\" server/src/server.ts",
    "dev:client": "node --env-file-if-exists=.env ./node_modules/webpack-dev-server/bin/webpack-dev-server.js --mode development --hot",
    "dev:all": "npm-run-all --parallel dev:server dev:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "node --env-file-if-exists=.env ./node_modules/webpack/bin/webpack.js --config webpack.config.prod.js --mode production",
    "build:client:stats": "ANALYZE_BUNDLE=true node --env-file-if-exists=.env ./node_modules/webpack/bin/webpack.js --config webpack.config.prod.js --mode production",
    "build:client:dev": "node --env-file-if-exists=.env ./node_modules/webpack/bin/webpack.js --mode development",
    "build": "npm run build:server && npm run build:client",
    "build:dev": "npm run build:server && npm run build:client:dev",
    "test:jest": "jest",
    "test:client": "jest --config jest.config.client.js",
    "test:client:watch": "jest --config jest.config.client.js --watch",
    "test:coverage": "jest --config jest.config.client.js --coverage",
    "test:e2e": "playwright test",
    "test:perf:budgets": "node scripts/perf/check-perf-budgets.mjs",
    "test:parity:server:checklist": "jest --config jest.config.server.js tests/server/parity-checklist.test.js",
    "test:parity:url-contracts": "jest --config jest.config.server.js tests/server/url-format-drift-approvals.test.js tests/server/url-format-drift-runtime.test.js",
    "test:contracts:legacy-modern": "jest --config jest.config.server.js tests/server/legacy-modern-adapter-contracts.test.js",
    "test:parity:server": "npm-run-all test:parity:server:checklist test:parity:url-contracts",
    "test:parity:client": "jest --config jest.config.client.js client/src/context/AuthContext.test.tsx client/src/components/Auth/SocialLoginButtons.test.tsx client/src/routes/routeConfig.test.tsx client/src/components/Entry/EntryActionsMenu.test.tsx client/src/services/api/admin.test.ts client/src/services/api/moderation.test.ts",
    "test:parity:setup-creds": "node scripts/qa/setup-parity-test-creds.mjs",
    "test:parity:screenshots": "node scripts/qa/migration-parity-screenshots.mjs",
    "test:parity:semantic": "node scripts/qa/migration-parity-semantic.mjs",
    "test:parity:authenticated": "node scripts/qa/migration-authenticated-parity.mjs",
    "test:parity:authenticated:disposable": "node --env-file-if-exists=.env scripts/qa/run-disposable-authenticated-parity.mjs",
    "test:policy:pilot": "node --env-file-if-exists=.env scripts/qa/content-policy-pilot.mjs",
    "test:parity": "npm-run-all test:parity:server test:parity:client",
    "test:upgrade:regression": "bash scripts/qa/upgrade-regression-batch.sh all",
    "test:upgrade:regression:tooling": "bash scripts/qa/upgrade-regression-batch.sh tooling",
    "test:upgrade:regression:test-runner": "bash scripts/qa/upgrade-regression-batch.sh test-runner",
    "test:upgrade:regression:lint-stack": "bash scripts/qa/upgrade-regression-batch.sh lint-stack",
    "test:upgrade:regression:react-stack": "bash scripts/qa/upgrade-regression-batch.sh react-stack",
    "test:upgrade:regression:server-core": "bash scripts/qa/upgrade-regression-batch.sh server-core",
    "test:upgrade:regression:native-modules": "bash scripts/qa/upgrade-regression-batch.sh native-modules",
    "test:ci": "npm-run-all lint type:guardrails lint:server-paths ci:server-paths lint:compat:isolation lint:compat:imports test:server test:parity test:coverage build:client build:server",
    "storybook": "storybook dev -p 6006 -c .storybook",
    "storybook:build": "storybook build -c .storybook",
    "lint": "eslint client tests/server --ext .ts,.tsx,.js",
    "lint:fix": "eslint client tests/server --ext .ts,.tsx,.js --fix",
    "ci:smoke": "npm-run-all lint type:check type:check:legacy type:guardrails type:guardrails:suppressions type:guardrails:any lint:guardrails:cjs lint:guardrails:cjs:legacy lint:guardrails:filesize",
    "format": "prettier --write .",
    "prepare": "husky install",
    "tsc": "tsc -p tsconfig.server.json",
    "tsc:watch": "tsc -p tsconfig.server.json --watch",
    "type:check": "tsc -p tsconfig.server.json --noEmit",
    "type:check:legacy": "tsc -p tsconfig.legacy.json --noEmit",
    "type:metrics": "bash scripts/type-metrics.sh",
    "type:guardrails": "bash scripts/check-no-new-ts-nocheck.sh",
    "type:guardrails:suppressions": "bash scripts/check-no-new-ts-suppressions.sh",
    "type:guardrails:any": "bash scripts/check-no-new-any.sh",
    "lint:guardrails:cjs": "bash scripts/check-no-new-cjs-modern.sh",
    "lint:guardrails:cjs:legacy": "bash scripts/check-no-new-cjs-legacy.sh",
    "lint:guardrails:filesize": "bash scripts/check-file-size-budget.sh",
    "lint:server-paths": "bash scripts/check-server-import-paths.sh",
    "lint:compat:isolation": "bash scripts/check-legacy-files-isolated.sh",
    "lint:compat:imports": "bash scripts/check-modern-no-compat-imports.sh",
    "ci:server-paths": "bash scripts/check-server-mixed-paths.sh",
    "docs:drift": "bash scripts/migration-doc-drift-check.sh",
    "runtime:pm2:check": "bash scripts/runtime/pm2-restart-check.sh",
    "runtime:preflight": "bash scripts/runtime/preflight-check.sh",
    "analyze:bundle": "npm run build:client:stats",
    "test:server": "jest --config jest.config.server.js",
    "start:legacy-grunt": "grunt --gruntfile legacy/build/Gruntfile.js --base ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wikitruth/wikitruth.git"
  },
  "dependencies": {
    "@tiptap/core": "^3.27.3",
    "@tiptap/extension-code-block-lowlight": "^3.27.3",
    "@tiptap/extension-image": "^3.27.3",
    "@tiptap/extension-link": "^3.27.3",
    "@tiptap/extension-table": "^3.27.3",
    "@tiptap/extension-table-cell": "^3.27.3",
    "@tiptap/extension-table-header": "^3.27.3",
    "@tiptap/extension-table-row": "^3.27.3",
    "@tiptap/extension-underline": "^3.27.3",
    "@tiptap/pm": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "@types/dompurify": "^3.0.5",
    "@types/sanitize-html": "^2.16.1",
    "adaro": "^0.1.10",
    "async": "^3.2.6",
    "backbone": "^1.6.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.3.0",
    "compression": "^1.8.1",
    "connect-mongo": "6.0.0",
    "consolidate": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.12",
    "dust-makara-helpers": "^4.2.0",
    "dustjs-helpers": "~1.3.0",
    "emailjs": "2.2.0",
    "engine-munger": "^0.2.9",
    "express": "^4.22.2",
    "express-session": "^1.18.2",
    "handlebars": "^4.7.8",
    "helmet": "8.2.0",
    "html-to-text": "^9.0.5",
    "imagemagick": "^0.1.3",
    "jade": "^1.11.0",
    "jsonwebtoken": "^9.0.3",
    "kraken-js": "^2.5.0",
    "less": "^3.13.1",
    "less-plugin-clean-css": "^1.6.0",
    "localizr": "^1.1.0",
    "makara": "^2.1.0",
    "method-override": "^3.0.0",
    "moment": "^2.30.1",
    "mongoose": "9.7.4",
    "morgan": "^1.11.0",
    "mv": "^2.1.1",
    "npm-run-all": "^4.1.5",
    "passport": "^0.7.0",
    "passport-apple": "^2.0.2",
    "passport-facebook": "^3.0.0",
    "passport-github": "^1.1.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "passport-microsoft": "^2.1.0",
    "passport-oauth1": "^1.3.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-google-recaptcha-v3": "^1.11.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "7.18.1",
    "rimraf": "^6.0.1",
    "sanitize-html": "2.17.5",
    "serve-static": "^2.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-docs": "10.5.0",
    "@storybook/react-webpack5": "10.5.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/async": "^3.2.24",
    "@types/bcrypt": "^5.0.2",
    "@types/body-parser": "^1.19.5",
    "@types/compression": "^1.7.5",
    "@types/consolidate": "^0.14.4",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/express-session": "^1.18.1",
    "@types/jest": "30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/kraken-js": "^2.2.8",
    "@types/method-override": "^0.0.35",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.20.1",
    "@types/passport": "^1.0.17",
    "@types/passport-facebook": "^3.0.3",
    "@types/passport-github": "^1.1.12",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "babel-loader": "9.1.3",
    "css-loader": "7.1.4",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
