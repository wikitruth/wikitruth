style.
  a:focus,
  a:focus-visible,
  button:focus,
  button:focus-visible,
  .btn:focus,
  .btn:focus-visible,
  [role='button']:focus,
  [role='button']:focus-visible,
  .btn-link:focus,
  .btn-link:focus-visible,
  .nav > li > a:focus,
  .nav > li > a:focus-visible {
    outline: none !important;
    box-shadow: none !important;
  }
