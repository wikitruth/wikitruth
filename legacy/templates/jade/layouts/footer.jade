div.footer
    div.container-fluid
        div.inner
            span.copyright.pull-right
                |&#169; #{copyrightYear}&nbsp;
                a(href='https://github.com/wikitruth', target='_blank') Wikitruth
                    span.hidden-xs &nbsp;Foundation
            ul.links
                li: a(href='#{legacyBaseUrl || "/"}') Home
                li: a(href='https://www.facebook.com/wikitruth.project') Facebook
                li: a(href='https://github.com/wikitruth/wikitruth', target='_blank', rel='noreferrer') Source
                li: a(href='https://github.com/wikitruth/wikitruth/blob/develop/LICENSE', target='_blank', rel='noreferrer') License
                //li: a(href='//blog.wikitruth.co') Blog
                li: a(href='#{paths.about}') About
                li: a(href='#{paths.contact}') Contact
            div.clearfix

div.ajax-spinner
    img(src='/img/ajax-pulse.gif', alt='Loading')

